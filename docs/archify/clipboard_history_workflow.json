      "width": 118
    },
    {
      "id": "clip",
      "lane": "capture",
      "col": 1,
      "type": "external",
      "label": "Windows 剪贴板",
      "sublabel": "文本 / 位图",
      "width": 132
    },
    {
      "id": "listener",
      "lane": "capture",
